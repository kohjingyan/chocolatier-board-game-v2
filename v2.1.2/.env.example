# Local rooms (npm run party):
VITE_PARTYKIT_HOST=127.0.0.1:1999

# Public rooms (Cloudflare Worker, not partykit.dev):
# Shared PartyKit hosting is full, so rooms deploy with Wrangler:
#   npm run party:deploy
# Copy the printed workers.dev host (no https://), then in Vercel
# Project Settings → Environment Variables set:
# VITE_PARTYKIT_HOST=chocolatier-playtest.YOUR-SUBDOMAIN.workers.dev
# Redeploy the Vercel site so the value is baked into the build.
